# ===============================
# DATABASE (MySQL)
# ===============================
# allowPublicKeyRetrieval=true tránh lỗi "Public Key Retrieval is not allowed"
# khi dùng plugin xác thực caching_sha2_password (mặc định MySQL 8+).
DB_URL=jdbc:mysql://localhost:3306/shopSpringSecurity?useUnicode=true&characterEncoding=UTF-8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=xxx

# ===============================
# JPA
# ===============================
DDL_AUTO=update
SHOW_SQL=true

# ===============================
# SERVER
# ===============================
SERVER_PORT=8080

# ===============================
# SMTP (dùng App Password nếu là Gmail)
# ===============================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=xxx@gmail.com
MAIL_PASSWORD=xxx

# ===============================
# CLOUDINARY
# ===============================
CLOUDINARY_CLOUD_NAME=xxx
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx

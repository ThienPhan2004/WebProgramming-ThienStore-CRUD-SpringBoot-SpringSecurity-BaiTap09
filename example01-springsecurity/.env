# ===============================
# DATABASE (MySQL)
# ===============================
# allowPublicKeyRetrieval=true tránh lỗi "Public Key Retrieval is not allowed"
# khi dùng plugin xác thực caching_sha2_password (mặc định MySQL 8+).
DB_URL=jdbc:mysql://localhost:3306/login_demo?useUnicode=true&characterEncoding=UTF-8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=123456

# ===============================
# JPA
# ===============================
DDL_AUTO=update
SHOW_SQL=true

# ===============================
# SERVER
# ===============================
SERVER_PORT=8080

# ===============================
# TÀI KHOẢN ADMIN MẪU (được seed tự động lúc khởi động)
# ===============================
ADMIN_EMAIL=admin@shop.vn
ADMIN_PASSWORD=123456
